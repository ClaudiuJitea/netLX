<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetLX.UI.ViewModels"
        xmlns:models="using:NetLX.Core.Models"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="NetLX.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="netLX — Network Field Tester"
        Icon="/Assets/netlx.ico"
        Width="1180" Height="720"
        MinWidth="960" MinHeight="600"
        TransparencyBackgroundFallback="#07090C"
        Background="#07090C">

    <Grid ColumnDefinitions="210,*" RowDefinitions="58,*,28" Background="#07090C">
        <!-- Brand rail header -->
        <Border Grid.Row="0" Grid.Column="0" Background="#0C1016" BorderBrush="#1A2230" BorderThickness="0,0,1,1">
            <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="14,0">
                <Image Source="/Assets/netlx.png" Width="34" Height="34" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                <StackPanel Spacing="0">
                    <TextBlock Text="netLX" FontWeight="Black" FontSize="17" Foreground="#F2F5F8"/>
                    <TextBlock Text="NETWORK FIELD TESTER" FontSize="10" Foreground="#2EE6D6" LetterSpacing="1.4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Top toolbar -->
        <Border Grid.Row="0" Grid.Column="1" Background="#0E131B" BorderBrush="#1A2230" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="18" Margin="14,0" Height="34" VerticalAlignment="Center">
                <Grid ColumnDefinitions="Auto,220,40" ColumnSpacing="10">
                    <TextBlock Text="ADAPTER" Classes="kicker" LineHeight="16" VerticalAlignment="Center"/>
                    <ComboBox Classes="toolbar"
                              Grid.Column="1"
                              Height="34"
                              MinWidth="220"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding Session.Adapters}"
                              SelectedItem="{Binding Session.SelectedAdapter}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:AdapterInfo">
                                <TextBlock Text="{Binding DisplayLabel}" LineHeight="18" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Classes="ghost" Command="{Binding RefreshAdaptersCommand}"
                            Width="40" Height="34" Padding="0"
                            IsEnabled="{Binding !Session.IsScanning}" ToolTip.Tip="Rescan NICs">
                        <materialIcons:MaterialIcon Kind="RefreshCircle" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" Height="34" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="3" Height="26" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Session.Rates.RxValueLabel, FallbackValue='0.00 Mbps'}"
                                   Foreground="{StaticResource OkBrush}" FontFamily="{StaticResource Mono}" FontSize="11"
                                   LineHeight="16" VerticalAlignment="Center"/>
                        <materialIcons:MaterialIcon Kind="ArrowDown" Width="12" Height="12"
                                                    Foreground="{StaticResource OkBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="3" Height="26" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Session.Rates.TxValueLabel, FallbackValue='0.00 Mbps'}"
                                   Foreground="{StaticResource BlueBrush}" FontFamily="{StaticResource Mono}" FontSize="11"
                                   LineHeight="16" VerticalAlignment="Center"/>
                        <materialIcons:MaterialIcon Kind="ArrowUp" Width="12" Height="12"
                                                    Foreground="{StaticResource BlueBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Border Background="#171E28" BorderBrush="{StaticResource BorderBrushSoft}"
                            BorderThickness="1" CornerRadius="7" Height="26" Padding="8,0" VerticalAlignment="Center">
                        <TextBlock FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                   LineHeight="14" VerticalAlignment="Center">
                            <Run Text="ERR "/><Run Text="{Binding Session.Rates.RxErrors, FallbackValue=0}"/>
                            <Run Text="/"/><Run Text="{Binding Session.Rates.TxErrors, FallbackValue=0}"/>
                            <Run Text="  DROP "/><Run Text="{Binding Session.Rates.RxDropped, FallbackValue=0}"/>
                            <Run Text="/"/><Run Text="{Binding Session.Rates.TxDropped, FallbackValue=0}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation -->
        <Border Grid.Row="1" Grid.Column="0" Background="#0C1016" BorderBrush="#1A2230" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="18,10,18,16" Spacing="4">
                    <TextBlock TextWrapping="Wrap" Text="Network diagnostics for Linux and Windows."
                               Classes="muted" FontSize="11"/>
                    <TextBlock Text="{Binding VersionLabel}" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="#3D5A56"/>
                </StackPanel>
                <ListBox Classes="nav" ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Grid ColumnDefinitions="Auto,*" Margin="8,6">
                                <Border Width="30" Height="30" CornerRadius="8" Background="#141B24" Margin="0,0,10,0">
                                    <materialIcons:MaterialIcon Kind="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#2EE6D6"/>
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Caption}" FontSize="11" Foreground="#6B7789"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Page host -->
        <Border Grid.Row="1" Grid.Column="1" Background="#07090C" Padding="14">
            <ContentControl Content="{Binding CurrentPage}"/>
        </Border>

        <!-- Status bar -->
        <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Background="#0A0D12" BorderBrush="#1A2230" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="16,0">
                <TextBlock Text="{Binding Session.StatusLine}" VerticalAlignment="Center" FontSize="11" Foreground="#8B96A8" FontFamily="{StaticResource Mono}"/>
                <TextBlock Grid.Column="1" Text="L2 · L3 · CAPTURE · TDR" VerticalAlignment="Center" FontSize="10" Foreground="#3D5A56" LetterSpacing="1.5"/>
            </Grid>
        </Border>
    </Grid>
</Window>
