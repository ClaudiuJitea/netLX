<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetLX.UI.ViewModels" xmlns:models="using:NetLX.Core.Models"
             xmlns:conv="using:NetLX.UI.Converters" xmlns:controls="using:NetLX.UI.Controls"
             xmlns:icons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="NetLX.UI.Views.CableView" x:DataType="vm:CableViewModel">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="12">
            <Border Classes="pageHero">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="13">
                    <Border Width="42" Height="42" CornerRadius="11" Background="{StaticResource AccentDimBrush}">
                        <icons:MaterialIcon Kind="EthernetCable" Width="23" Height="23" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="CABLE &amp; PHY DIAGNOSTICS" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Visual link health, pair-level TDR diagnostics, and optical transceiver telemetry." Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding ProgressText}" Margin="0,3,0,0" FontSize="11" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="DISTANCE UNIT" Classes="kicker"/>
                        <ComboBox ItemsSource="{Binding Units}" SelectedItem="{Binding Unit}" MinWidth="120"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="ACTION" Classes="kicker"/>
                        <Button Classes="primary" Command="{Binding RunCommand}" MinHeight="34">
                            <Button.IsEnabled><MultiBinding Converter="{x:Static conv:BoolAndMultiConverter.Instance}"><Binding Path="Session.HasAdapter"/><Binding Path="!IsRunning"/></MultiBinding></Button.IsEnabled>
                            <StackPanel Orientation="Horizontal" Spacing="8"><icons:MaterialIcon Kind="Pulse" Width="16" Height="16"/><TextBlock Text="RUN CABLE TEST"/></StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Classes="card" IsVisible="{Binding HasResult}">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="3"><TextBlock Text="TEST RESULT" Classes="kicker"/><TextBlock Text="{Binding Result.Summary}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel>
                        <Border Grid.Column="1" Classes="badge" Background="#342A15" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Result.TdrLabel}" FontWeight="Bold" FontSize="11" Foreground="{Binding Result, Converter={x:Static conv:CableResultBrushConverter.Instance}}"/>
                        </Border>
                    </Grid>
                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                        <Border Classes="inset"><StackPanel Spacing="3"><TextBlock Text="PHYSICAL LINK" Classes="kicker"/><TextBlock Text="{Binding Result.Phy.LinkLabel}" Classes="metric" Foreground="{Binding Result.LinkUp, Converter={x:Static conv:BoolToBrushConverter.Ready}}"/><TextBlock Text="{Binding Result.Phy.Port}" Classes="muted" FontSize="11"/></StackPanel></Border>
                        <Border Grid.Column="1" Classes="inset"><StackPanel Spacing="3"><TextBlock Text="NEGOTIATED" Classes="kicker"/><TextBlock Text="{Binding Result.Phy.SpeedLabel}" Classes="metric"/><TextBlock Text="{Binding Result.Phy.Duplex, StringFormat='{}{0} duplex'}" Classes="muted" FontSize="11"/></StackPanel></Border>
                        <Border Grid.Column="2" Classes="inset"><StackPanel Spacing="3"><TextBlock Text="LOCAL / PARTNER MAX" Classes="kicker"/><TextBlock FontSize="17" FontWeight="SemiBold"><Run Text="{Binding Result.Phy.LocalMaximum}"/><Run Text="  /  "/><Run Text="{Binding Result.Phy.PartnerMaximum}"/></TextBlock><TextBlock Text="Advertised capability" Classes="muted" FontSize="11"/></StackPanel></Border>
                        <Border Grid.Column="3" Classes="inset"><StackPanel Spacing="3"><TextBlock Text="AUTO-NEG / MDI-X" Classes="kicker"/><TextBlock Text="{Binding Result.Phy.NegotiationLabel}" Classes="metric"/><TextBlock Text="{Binding Result.Phy.MdiX, StringFormat='MDI-X {0}'}" Classes="muted" FontSize="11"/></StackPanel></Border>
                    </Grid>
                    <controls:CableDiagram Result="{Binding Result}" Height="235" MinWidth="520"/>
                    <Border Background="#342A15" BorderBrush="#65501F" BorderThickness="1" CornerRadius="8" Padding="12" IsVisible="{Binding HasUnsupportedResult}">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <icons:MaterialIcon Kind="InformationOutline" Width="22" Height="22" Foreground="{StaticResource WarnBrush}"/>
                            <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="WHY THERE IS NO PAIR MAP" FontWeight="Bold" Foreground="{StaticResource WarnBrush}"/><TextBlock Text="The Ethernet connection can work normally while the NIC or driver provides no TDR measurements. netLX can still show negotiated PHY health, but open/short location and individual pair condition require a TDR-capable adapter." TextWrapping="Wrap" Classes="muted"/></StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Classes="inset" IsVisible="{Binding !HasResult}" MinHeight="130">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8"><icons:MaterialIcon Kind="CableData" Width="30" Height="30" Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"/><TextBlock Text="Run a cable test to visualize the link and pair status." Classes="muted" FontWeight="SemiBold"/><TextBlock Text="Available detail depends on what the selected NIC and driver expose." Classes="muted" FontSize="11"/></StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Result.Pairs}" IsVisible="{Binding HasPairs}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:CablePairResult">
                    <Border Classes="card" MinWidth="250" Margin="0,0,10,10" Padding="13"><Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                        <Ellipse Width="13" Height="13" Fill="{Binding ., Converter={x:Static conv:CablePairBrushConverter.Instance}}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Pair}" FontWeight="Bold"/><TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap"/></StackPanel>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right"><TextBlock Text="{Binding StateLabel}" FontWeight="Bold" Foreground="{Binding ., Converter={x:Static conv:CablePairBrushConverter.Instance}}"/><TextBlock Text="{Binding Distance}" FontFamily="{StaticResource Mono}" Classes="muted"/></StackPanel>
                    </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid ColumnDefinitions="5*,7*" ColumnSpacing="12" IsVisible="{Binding HasResult}">
                <Border Classes="card" IsVisible="{Binding HasSfpResult}" Padding="16">
                    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="11">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentDimBrush}">
                                <icons:MaterialIcon Kind="ExpansionCardVariant" Width="18" Height="18" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="SFP / OPTICS" Classes="kicker" Foreground="{StaticResource AccentBrush}"/>
                                <TextBlock Text="TRANSCEIVER TELEMETRY" Classes="muted" FontSize="11"/>
                            </StackPanel>
                            <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center">
                                <TextBlock Text="DDM" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"/>
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1" Text="{Binding SfpResult.Summary}" FontWeight="SemiBold" TextWrapping="Wrap"/>

                        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                            <Border Classes="inset" Padding="10,8">
                                <StackPanel Spacing="2"><TextBlock Text="TEMPERATURE" Classes="kicker"/><TextBlock Text="{Binding SfpResult.Temperature}" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Grid.Column="1" Classes="inset" Padding="10,8">
                                <StackPanel Spacing="2"><TextBlock Text="VOLTAGE" Classes="kicker"/><TextBlock Text="{Binding SfpResult.Voltage}" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Classes="inset" Padding="10,8">
                                <StackPanel Spacing="2"><TextBlock Text="TX POWER" Classes="kicker"/><TextBlock Text="{Binding SfpResult.TxPower}" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Classes="inset" Padding="10,8">
                                <StackPanel Spacing="2"><TextBlock Text="RX POWER" Classes="kicker"/><TextBlock Text="{Binding SfpResult.RxPower}" FontWeight="SemiBold"/></StackPanel>
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="4" Spacing="5">
                            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap"><Run Text="{Binding SfpResult.Vendor}"/><Run Text="  ·  "/><Run Text="{Binding SfpResult.PartNumber}"/><Run Text="  ·  S/N "/><Run Text="{Binding SfpResult.Serial}"/></TextBlock>
                            <TextBlock Text="{Binding SfpResult.Alarms}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Classes="card" Background="#0B1017" Padding="0" ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <Border Background="#101823" BorderBrush="{StaticResource BorderBrushSoft}" BorderThickness="0,0,0,1" Padding="14,11">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                <icons:MaterialIcon Kind="ConsoleLine" Width="17" Height="17" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="RAW DRIVER OUTPUT" Classes="kicker" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" Classes="badge" Background="#202A38">
                                    <TextBlock Text="ethtool" FontFamily="{StaticResource Mono}" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ScrollViewer Grid.Row="1" MinHeight="218" MaxHeight="300" Padding="14,12">
                            <TextBlock Text="{Binding Result.RawOutput}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="#B7C4D4" LineHeight="18" TextWrapping="Wrap"/>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
