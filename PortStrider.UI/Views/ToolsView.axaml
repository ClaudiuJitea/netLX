<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PortStrider.UI.ViewModels"
             xmlns:models="using:PortStrider.Core.Models"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PortStrider.UI.Views.ToolsView"
             x:DataType="vm:ToolsViewModel">
    <UserControl.Styles>
        <Style Selector="TabControl.toolsTabs">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TabControl.toolsTabs TabItem">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
        </Style>
        <Style Selector="TabControl.toolsTabs TabItem:selected">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        </Style>
        <Style Selector="DataGrid.toolGrid">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserResizeColumns" Value="True"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
        </Style>
        <Style Selector="Border.toolHero">
            <Setter Property="Background" Value="#0E171F"/>
            <Setter Property="BorderBrush" Value="#1D3B3C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16,13"/>
        </Style>
        <Style Selector="Border.toolInput">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="Border.stat">
            <Setter Property="Background" Value="#10161F"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSoft}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*" RowSpacing="12">
        <Border Classes="toolHero">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="13">
                <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentDimBrush}">
                    <materialIcons:MaterialIcon Kind="Tools" Width="20" Height="20"
                                                Foreground="{StaticResource AccentBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="NETWORK TOOLKIT" Classes="kicker" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Run focused connectivity, path, service, web and throughput diagnostics."
                               Classes="muted" FontSize="12"/>
                </StackPanel>
                <Button Grid.Column="3" Content="STOP TESTS" Classes="danger" Command="{Binding StopTestsCommand}"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                    <TextBlock Text="ACTIVE INTERFACE" Classes="kicker" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Session.SelectedAdapter.Name, FallbackValue='None selected'}"
                               FontFamily="{StaticResource Mono}" FontWeight="SemiBold" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Classes="toolsTabs">
        <TabItem Header="Ping">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="0,10,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Text="ICMP ECHO" Classes="kicker"/>
                        <TextBlock Text="Measure reachability, latency and packet loss continuously." Classes="muted" FontSize="12"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="stat" MinWidth="310">
                        <TextBlock Text="{Binding PingStats}" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" FontFamily="{StaticResource Mono}" FontSize="11"/>
                    </Border>
                </Grid>
                <Border Grid.Row="1" Classes="toolInput">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="DESTINATION" Classes="kicker"/>
                            <TextBox Classes="field" Watermark="Hostname or IP address" Text="{Binding PingHost}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="primary" Command="{Binding TogglePingCommand}"
                                VerticalAlignment="Bottom" MinWidth="105">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <materialIcons:MaterialIcon Kind="AccessPointNetwork" Width="16" Height="16"/>
                                <TextBlock Text="{Binding PingButtonLabel}"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <DataGrid Grid.Row="2" Classes="toolGrid" ItemsSource="{Binding PingSamples}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SEQUENCE" Binding="{Binding Sequence}" Width="110"/>
                        <DataGridTextColumn Header="RESULT" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="ROUND TRIP" Binding="{Binding RoundtripMs, StringFormat='{}{0} ms'}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="DNS">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="0,10,0,0">
                <Border Classes="toolInput">
                    <Grid ColumnDefinitions="*,2*,130,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="5"><TextBlock Text="DNS SERVER IP" Classes="kicker"/><TextBox Classes="field" Text="{Binding DnsServer}"/></StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="QUERY NAME" Classes="kicker"/><TextBox Classes="field" Text="{Binding DnsName}"/></StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5"><TextBlock Text="RECORD TYPE" Classes="kicker"/><ComboBox ItemsSource="{Binding DnsTypes}" SelectedItem="{Binding DnsType}"/></StackPanel>
                        <Button Grid.Column="3" Content="LOOKUP" Classes="primary" Command="{Binding LookupDnsCommand}" IsEnabled="{Binding !IsDns}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Row="1" Text="{Binding DnsStatus}" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" Foreground="{StaticResource AccentBrush}"/>
                <DataGrid Grid.Row="2" Classes="toolGrid" ItemsSource="{Binding DnsAnswers}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="90"/>
                        <DataGridTextColumn Header="TTL (s)" Binding="{Binding Ttl}" Width="90"/>
                        <DataGridTextColumn Header="ANSWER" Binding="{Binding Value}" Width="3*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Trace">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="0,10,0,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="PATH DISCOVERY" Classes="kicker"/>
                    <TextBlock Text="Map routed hops to the destination using the operating system routing table." Classes="muted" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Classes="toolInput">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="DESTINATION" Classes="kicker"/>
                            <TextBox Classes="field" Watermark="Hostname or IP address" Text="{Binding TraceHost}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="primary" Command="{Binding TraceCommand}"
                                IsEnabled="{Binding !IsTracing}" VerticalAlignment="Bottom" MinWidth="105">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <materialIcons:MaterialIcon Kind="Routes" Width="16" Height="16"/>
                                <TextBlock Text="TRACE"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <DataGrid Grid.Row="2" Classes="toolGrid" ItemsSource="{Binding Hops}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="HOP" Binding="{Binding Ttl}" Width="90"/>
                        <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="*"/>
                        <DataGridTextColumn Header="ROUND TRIP" Binding="{Binding Rtt}" Width="180"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="Ports">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="0,10,0,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="TCP SERVICE PROBE" Classes="kicker"/>
                    <TextBlock Text="Probe up to 64 distinct TCP ports, with eight concurrent connections. Closed ports may be expected."
                               Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="1" Classes="toolInput">
                    <Grid ColumnDefinitions="2*,3*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="TARGET HOST" Classes="kicker"/>
                            <TextBox Classes="field" Watermark="Gateway, hostname or IP" Text="{Binding PortHost}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="PORTS" Classes="kicker"/>
                            <TextBox Classes="field" Watermark="22, 53, 80, 443" Text="{Binding PortList}"/>
                        </StackPanel>
                        <Button Grid.Column="2" Classes="primary" Command="{Binding ProbePortsCommand}"
                                IsEnabled="{Binding !IsProbingPorts}" VerticalAlignment="Bottom" MinWidth="105">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <materialIcons:MaterialIcon Kind="LanConnect" Width="16" Height="16"/>
                                <TextBlock Text="PROBE"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <DataGrid Grid.Row="2" Classes="toolGrid" ItemsSource="{Binding Ports}" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="110"/>
                        <DataGridTextColumn Header="SERVICE" Binding="{Binding Service}" Width="*"/>
                        <DataGridTextColumn Header="STATE" Binding="{Binding StatusLabel}" Width="150"/>
                        <DataGridTextColumn Header="LATENCY" Binding="{Binding ElapsedMs, StringFormat='{}{0} ms'}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </TabItem>

        <TabItem Header="HTTP / TLS">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="0,10,0,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="WEB &amp; CERTIFICATE CHECK" Classes="kicker"/>
                    <TextBlock Text="Validate HTTP response, TLS negotiation and the remote certificate." Classes="muted" FontSize="12"/>
                </StackPanel>
                <Border Grid.Row="1" Classes="toolInput">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="URL" Classes="kicker"/>
                            <TextBox Classes="field" Watermark="https://example.com" Text="{Binding HttpUrl}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="primary" Command="{Binding ProbeHttpCommand}"
                                IsEnabled="{Binding !IsHttp}" VerticalAlignment="Bottom" MinWidth="105">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <materialIcons:MaterialIcon Kind="ShieldSearch" Width="16" Height="16"/>
                                <TextBlock Text="CHECK"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Classes="card" IsVisible="{Binding HasHttpResult}">
                    <Grid ColumnDefinitions="190,*" ColumnSpacing="20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="RESPONSE" Classes="kicker"/>
                            <TextBlock Text="{Binding HttpResult.StatusCode, StringFormat='HTTP {0}'}" Classes="metric"
                                       Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="{Binding HttpResult.ElapsedMs, StringFormat='{}{0} ms elapsed'}"
                                       Classes="muted" FontFamily="{StaticResource Mono}"/>
                            <TextBlock Text="{Binding HttpResult.TlsProtocol}" Foreground="{StaticResource BlueBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="7">
                            <TextBlock Text="CERTIFICATE SUBJECT" Classes="kicker"/>
                            <TextBlock Text="{Binding HttpResult.CertificateSubject}" TextWrapping="Wrap"/>
                            <TextBlock Text="ISSUER" Classes="kicker" Margin="0,5,0,0"/>
                            <TextBlock Text="{Binding HttpResult.CertificateIssuer}" Classes="muted" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HttpResult.FinalUrl}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HttpResult.SourceAddress, StringFormat='Source: {0}'}"/>
                            <TextBlock Text="{Binding HttpResult.CertificateError}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding HttpResult.Error}" Foreground="{StaticResource ErrBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>

        <TabItem Header="iPerf3">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12" Margin="0,10,0,0">
                <StackPanel Spacing="3">
                    <TextBlock Text="THROUGHPUT TEST" Classes="kicker"/>
                    <TextBlock Text="Measure bandwidth against an iPerf3 endpoint, or run this tester as the far-end server. Uses OS routing; the server listens on all interfaces."
                               Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Row="1" Classes="toolInput">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="5">
                            <TextBlock Text="SERVER HOST" Classes="kicker"/>
                            <TextBox Classes="field" Watermark="Hostname or IP address" Text="{Binding IperfHost}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="5">
                            <TextBlock Text="DURATION" Classes="kicker"/>
                            <NumericUpDown Value="{Binding IperfSeconds}" Minimum="1" Maximum="60" Width="100" FormatString="0 s"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="5">
                            <TextBlock Text="PORT" Classes="kicker"/>
                            <NumericUpDown Value="{Binding IperfPort}" Minimum="1" Maximum="65535" Width="110"/>
                        </StackPanel>
                        <Button Grid.Column="3" Classes="primary" Command="{Binding RunIperfCommand}"
                                IsEnabled="{Binding !IsIperf}" VerticalAlignment="Bottom">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <materialIcons:MaterialIcon Kind="PlaySpeed" Width="16" Height="16"/>
                                <TextBlock Text="RUN CLIENT"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="4" Classes="ghost" Command="{Binding ToggleIperfServerCommand}"
                                Content="{Binding ServerButtonLabel}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Classes="card" Background="#0B1017">
                    <ScrollViewer>
                        <TextBlock Text="{Binding IperfLog, FallbackValue='iPerf3 output will appear here…'}"
                                   FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="19"
                                   Foreground="#B7C4D4" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </TabItem>
        </TabControl>
    </Grid>
</UserControl>
