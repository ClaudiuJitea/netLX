<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PortStrider.UI.ViewModels"
             xmlns:conv="using:PortStrider.UI.Converters"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="PortStrider.UI.Views.VlanMonitorView"
             x:DataType="vm:VlanMonitorViewModel">
    <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
        <Border Classes="pageHero">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="13">
                <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentDimBrush}">
                    <materialIcons:MaterialIcon Kind="ChartDonutVariant" Width="20" Height="20"
                                                Foreground="{StaticResource AccentBrush}"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="VLAN MONITOR" Classes="kicker" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="Observe tagged traffic and identify the busiest VLANs on the selected interface."
                               Classes="muted" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="2">
                    <TextBlock Text="ACTIVE INTERFACE" Classes="kicker" TextAlignment="Right"/>
                    <TextBlock Text="{Binding Session.SelectedAdapter.Name, FallbackValue='None selected'}"
                               FontFamily="{StaticResource Mono}" FontWeight="SemiBold" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Classes="toolbarCard">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                <StackPanel Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="CAPTURE STATUS" Classes="kicker"/>
                    <TextBlock Text="{Binding Status}" Foreground="{StaticResource AccentBrush}"
                               FontFamily="{StaticResource Mono}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="primary" Command="{Binding StartCommand}">
                        <Button.IsEnabled>
                            <MultiBinding Converter="{x:Static conv:BoolAndMultiConverter.Instance}">
                                <Binding Path="Session.HasAdapter"/>
                                <Binding Path="!IsRunning"/>
                            </MultiBinding>
                        </Button.IsEnabled>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <materialIcons:MaterialIcon Kind="PlayCircle" Width="16" Height="16"/>
                            <TextBlock Text="START MONITOR"/>
                        </StackPanel>
                    </Button>
                    <Button Classes="danger" Command="{Binding StopCommand}" IsEnabled="{Binding IsRunning}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <materialIcons:MaterialIcon Kind="StopCircle" Width="16" Height="16"/>
                            <TextBlock Text="STOP"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Classes="inset">
                <StackPanel Spacing="3">
                    <TextBlock Text="TRAFFIC GROUPS" Classes="kicker"/>
                    <TextBlock Text="{Binding Observations.Count}" Classes="metric"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="inset">
                <StackPanel Spacing="3">
                    <TextBlock Text="DISPLAY LIMIT" Classes="kicker"/>
                    <TextBlock Text="Top 9 by bytes + other / untagged" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="3">
            <DataGrid ItemsSource="{Binding Observations}" IsReadOnly="True"
                      CanUserResizeColumns="True" CanUserSortColumns="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="OUTER VLAN" Binding="{Binding Label}" Width="180"/>
                    <DataGridTextColumn Header="FRAMES" Binding="{Binding Frames}" Width="180"/>
                    <DataGridTextColumn Header="BYTES" Binding="{Binding Bytes}" Width="180"/>
                    <DataGridTextColumn Header="TRAFFIC SHARE" Binding="{Binding SharePercent, StringFormat='{}{0:0.0}%'}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel IsVisible="{Binding !HasObservations}" HorizontalAlignment="Center"
                        VerticalAlignment="Center" Spacing="7">
                <materialIcons:MaterialIcon Kind="ChartDonutVariant" Width="30" Height="30"
                                            Foreground="{StaticResource DimBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="No traffic observed" Foreground="{StaticResource MutedBrush}"
                           FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Start monitoring, then generate traffic on the connected port."
                           Classes="muted" FontSize="11" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
